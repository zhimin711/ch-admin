    "chalk": "2.4.2",
    "chokidar": "^3.5.3",
    "connect": "3.6.6",
    "eslint": "6.7.2",
    "eslint-plugin-vue": "6.2.2",
    "html-webpack-plugin": "3.2.0",
    "husky": "1.3.1",
    "less": "^2.7.3",
    "less-loader": "^4.0.5",
    "lint-staged": "^12.4.2",
    "mockjs": "1.0.1-beta3",
    "plop": "^2.7.6",
    "runjs": "^4.1.3",
    "sass": "1.33.0",
    "sass-loader": "8.0.2",
    "script-ext-html-webpack-plugin": "2.1.3",
