    "crypto-js": "^4.0.0",
    "diff-match-patch": "^1.0.5",
    "driver.js": "0.9.5",
    "dropzone": "5.5.1",
    "echarts": "^5.3.2",
    "element-ui": "2.15.7",
    "file-saver": "2.0.1",
    "fuse.js": "3.4.4",
    "js-cookie": "2.2.0",
    "jsonlint": "1.6.3",
    "jszip": "^3.10.0",
    "normalize.css": "7.0.0",
    "nprogress": "0.2.0",
    "path-to-regexp": "2.4.0",
    "screenfull": "4.2.0",
    "script-loader": "0.7.2",
    "sortablejs": "1.8.4",
    "tinymce": "^5.5.1",
    "v-click-outside-x": "^4.1.3",
    "v-org-tree": "^1.0.6",
    "vue": "2.6.10",
    "vue-amap": "^0.5.10",
    "vue-code-diff": "0.0.5",
    "vue-count-to": "1.0.13",
    "vue-cropperjs": "^2.2.0",
    "vue-i18n": "^8.22.2",
    "vue-lazyload": "^1.3.3",
    "vue-router": "3.0.2",
    "vue-splitpane": "1.0.4",
    "vue-video-player": "^5.0.2",
    "vuedraggable": "2.20.0",
    "vuex": "3.1.0",
    "xlsx": "^0.18.5"
