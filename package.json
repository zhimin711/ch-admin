  "engines": {
    "node": ">=12.0",
    "npm": ">= 8.0.0"
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "devops",
    "microservices",
    "nacos",
    "rocketmq",
    "canal",
    "management-system",
    "enterprise",
    "cloud-native"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhimin711/ch-admin2.git"
